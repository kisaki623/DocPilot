# Copy this file to deploy/prod/.env.prod on the server.
# Never commit the real .env.prod file.
#
# This template is intentionally conservative:
# - keep existing middleware, database, MinIO bucket, RocketMQ topic/group and Qdrant collection;
# - do not create a new empty Qdrant collection for an existing deployment;
# - do not enable hybrid / multi-query / rerank unless you already verified provider cost and quality.

# Docker networks.
# Container Caddy mode: existing Caddy must join DOCPILOT_APP_NETWORK.
# Host Caddy mode: use docker-compose.host-caddy.override.yml and keep ports bound to 127.0.0.1.
DOCPILOT_APP_NETWORK=docpilot-app
DOCPILOT_MIDDLEWARE_NETWORK=CHANGE_ME_EXISTING_MIDDLEWARE_NETWORK
DOCPILOT_FRONTEND_LOOPBACK_BIND=127.0.0.1:3000
DOCPILOT_BACKEND_LOOPBACK_BIND=127.0.0.1:8081

# Frontend server-side rewrite fallback. Public browser traffic should stay same-origin via reverse proxy /backend/api/*.
FRONTEND_BUILD_BACKEND_BASE_URL=http://backend:8081
FRONTEND_RUNTIME_BACKEND_BASE_URL=http://backend:8081

# Backend runtime.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
APP_QUALITY_CONSOLE_ENABLED=false
APP_QUALITY_CONSOLE_ENVIRONMENT=prod

# MySQL. Use the existing DocPilot schema name; prod profile defaults to docpilot_prod if omitted.
MYSQL_HOST=CHANGE_ME_MYSQL_CONTAINER_OR_DNS
MYSQL_PORT=3306
MYSQL_DATABASE=CHANGE_ME_EXISTING_SCHEMA
MYSQL_DB=CHANGE_ME_EXISTING_SCHEMA
MYSQL_USERNAME=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# Redis.
REDIS_HOST=CHANGE_ME_REDIS_CONTAINER_OR_DNS
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
APP_REDIS_KEY_PREFIX=docpilot:prod:

# RocketMQ. Keep the existing topic and producer / consumer groups unless you intentionally reset offsets.
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=CHANGE_ME_ROCKETMQ_NAMESRV:9876
ROCKETMQ_PRODUCER_GROUP=CHANGE_ME_EXISTING_PRODUCER_GROUP
ROCKETMQ_CONSUMER_GROUP=CHANGE_ME_EXISTING_CONSUMER_GROUP
DOCPILOT_PARSE_TOPIC=docpilot-parse-topic

# MinIO. Keep the existing bucket and base path so old files remain readable.
FILE_STORAGE_MODE=minio
MINIO_ENDPOINT=http://CHANGE_ME_MINIO_CONTAINER_OR_DNS:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=CHANGE_ME_EXISTING_BUCKET
MINIO_BASE_PATH=CHANGE_ME_EXISTING_BASE_PATH

# Qdrant. Must match the existing collection and embedding dimension.
# Current development facts recorded in docs/ai-dev/STATE.md are docpilot_rag_v2 / 1024,
# but verify the target server before copying those values.
RAG_VECTOR_STORE_PROVIDER=qdrant
RAG_QDRANT_HOST=CHANGE_ME_QDRANT_CONTAINER_OR_DNS
RAG_QDRANT_PORT=6333
RAG_QDRANT_COLLECTION=CHANGE_ME_EXISTING_COLLECTION
RAG_QDRANT_DIMENSION=CHANGE_ME_EXISTING_DIMENSION
RAG_QDRANT_DISTANCE=Cosine
RAG_QDRANT_COLLECTION_INIT_ENABLED=false

# Answer model. This project currently uses Aliyun Bailian OpenAI-compatible chat in local dev.
AI_MODE=real
AI_REAL_PROVIDER=openai-compatible
AI_REAL_BASE_URL=https://<YOUR_BAILIAN_WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_REAL_API_KEY=CHANGE_ME
AI_REAL_MODEL=qwen-plus
AI_REAL_TEMPERATURE=0.0
AI_REAL_MAX_OUTPUT_TOKENS=800
AI_REAL_CONNECT_TIMEOUT_MS=5000
AI_REAL_READ_TIMEOUT_MS=30000

# Embedding model. Dimension must match the selected embedding model and Qdrant collection.
APP_RAG_EMBEDDING_ENABLED=true
APP_RAG_EMBEDDING_PROVIDER=openai_compatible
APP_RAG_EMBEDDING_BASE_URL=https://<YOUR_BAILIAN_WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
APP_RAG_EMBEDDING_API_KEY=CHANGE_ME
APP_RAG_EMBEDDING_MODEL=text-embedding-v4
APP_RAG_EMBEDDING_DIMENSION=CHANGE_ME_EXISTING_DIMENSION
APP_RAG_EMBEDDING_CONNECT_TIMEOUT_MS=5000
APP_RAG_EMBEDDING_REQUEST_TIMEOUT_MS=30000

# Retrieval and rerank. Keep advanced features off unless you have verified them in the target runtime.
APP_RAG_RETRIEVAL_HYBRID_ENABLED=false
APP_RAG_RETRIEVAL_MULTI_QUERY_ENABLED=false
APP_RAG_RETRIEVAL_MAX_QUERY_VARIANTS=3
APP_RAG_RETRIEVAL_MIN_SIMILARITY_THRESHOLD=0.50
APP_RAG_RETRIEVAL_RRF_K=60
APP_RAG_RERANK_ENABLED=false
APP_RAG_RERANK_PROVIDER=aliyun_bailian
APP_RAG_RERANK_BASE_URL=https://<YOUR_BAILIAN_WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
APP_RAG_RERANK_API_KEY=CHANGE_ME
APP_RAG_RERANK_MODEL=qwen3-rerank
APP_RAG_RERANK_CONNECT_TIMEOUT_MS=5000
APP_RAG_RERANK_REQUEST_TIMEOUT_MS=30000

# Operational knobs.
APP_DOCUMENT_PARSER_MAX_FILE_SIZE_BYTES=20971520
APP_DOCUMENT_PARSER_TIMEOUT_MS=30000
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=20MB
AI_RETRY_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_BACKOFF_MS=120
AI_RETRY_BACKOFF_MULTIPLIER=2.0
AI_RETRY_MAX_BACKOFF_MS=800
ROCKETMQ_OUTBOX_SCAN_FIXED_DELAY_MS=15000
ROCKETMQ_OUTBOX_SCAN_BATCH_SIZE=20
ROCKETMQ_OUTBOX_RETRY_BACKOFF_SECONDS=30
ROCKETMQ_OUTBOX_MAX_RETRY_COUNT=20
REDISSON_LOCK_WATCHDOG_TIMEOUT_MS=30000
