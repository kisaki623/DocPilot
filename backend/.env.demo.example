# DocPilot demo profile: local dependencies from docker-compose.demo.yml
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# MySQL (docker compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=docpilot
MYSQL_DB=docpilot
MYSQL_USERNAME=docpilot
MYSQL_PASSWORD=docpilot

# Redis (docker compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RocketMQ (docker compose)
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=docpilot-producer-group
ROCKETMQ_CONSUMER_GROUP=docpilot-parse-consumer-group
DOCPILOT_PARSE_TOPIC=docpilot-parse-topic

# Local / MinIO storage switch
FILE_STORAGE_MODE=minio
FILE_UPLOAD_DIR=./data/uploads-local
FILE_CHUNK_TEMP_DIR=./data/upload-chunks-local
FILE_CHUNK_SESSION_TTL_SECONDS=86400

# MinIO (docker compose)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docpilot
MINIO_BASE_PATH=uploads

# Document parser
APP_DOCUMENT_PARSER_MAX_FILE_SIZE_BYTES=20971520
APP_DOCUMENT_PARSER_TIMEOUT_MS=10000

# AI defaults for demo
AI_MODE=mock
AI_MAX_DOCUMENT_CONTEXT_LENGTH=4000
AI_SESSION_CONTEXT_MAX_TURNS=6
AI_SESSION_CONTEXT_TTL_SECONDS=1800
AI_SESSION_CONTEXT_MAX_CHARS=1200
# Optional real-mode verification (OpenAI-compatible, including Alibaba Cloud Bailian):
# AI_MODE=real
# AI_REAL_PROVIDER=openai-compatible
# AI_REAL_BASE_URL=https://<YOUR_BAILIAN_WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# AI_REAL_API_KEY=__REPLACE_WITH_YOUR_BAILIAN_API_KEY__
# AI_REAL_MODEL=qwen-plus
# AI_REAL_CONNECT_TIMEOUT_MS=2000
# AI_REAL_READ_TIMEOUT_MS=8000
# AI_REAL_TEMPERATURE=0.2
# AI_REAL_MAX_OUTPUT_TOKENS=800
# AI_REAL_INPUT_COST_PER_1K_USD=0
# AI_REAL_OUTPUT_COST_PER_1K_USD=0
AI_RETRY_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_BACKOFF_MS=120
AI_RETRY_BACKOFF_MULTIPLIER=2.0
AI_RETRY_MAX_BACKOFF_MS=800

# RAG retrieval / rerank optional enhancements
APP_RAG_RETRIEVAL_HYBRID_ENABLED=false
APP_RAG_RETRIEVAL_MIN_SIMILARITY_THRESHOLD=0.50
APP_RAG_RETRIEVAL_RRF_K=60
APP_RAG_RERANK_ENABLED=false
APP_RAG_RERANK_PROVIDER=disabled
APP_RAG_RERANK_BASE_URL=
APP_RAG_RERANK_API_KEY=
APP_RAG_RERANK_MODEL=
APP_RAG_RERANK_CONNECT_TIMEOUT_MS=5000
APP_RAG_RERANK_REQUEST_TIMEOUT_MS=30000

# Optional Alibaba Cloud Bailian / DashScope rerank verification.
# For qwen3-rerank, BASE_URL is the full Bailian rerank endpoint, not the chat/embedding compatible-mode URL.
# APP_RAG_RETRIEVAL_HYBRID_ENABLED=true
# APP_RAG_RERANK_ENABLED=true
# APP_RAG_RERANK_PROVIDER=aliyun_bailian
# APP_RAG_RERANK_BASE_URL=https://<YOUR_BAILIAN_WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# APP_RAG_RERANK_API_KEY=__REPLACE_WITH_YOUR_BAILIAN_API_KEY__
# APP_RAG_RERANK_MODEL=qwen3-rerank

# Metrics and outbox retry
ROCKETMQ_OUTBOX_SCAN_FIXED_DELAY_MS=15000
ROCKETMQ_OUTBOX_SCAN_BATCH_SIZE=20
ROCKETMQ_OUTBOX_RETRY_BACKOFF_SECONDS=30
ROCKETMQ_OUTBOX_MAX_RETRY_COUNT=20
REDISSON_LOCK_WATCHDOG_TIMEOUT_MS=30000
REDISSON_PARSE_TASK_LOCK_FAIL_MESSAGE=当前文档解析任务处理中，请稍后重试
